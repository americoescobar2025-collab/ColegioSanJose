@model IEnumerable<ColegioSanJose.Models.Expediente>

<h2>Expedientes</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Expediente
    </a>

    <a asp-action="Promedios" class="btn btn-success">
        Ver Promedios
    </a>

    <a asp-action="Grafica" class="btn btn-warning">
        Ver Gráfica
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead class="table-dark">
        <tr>
            <th>Alumno</th>
            <th>Materia</th>
            <th>Nota</th>
            <th>Estado</th>
            <th>Observaciones</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Alumno?.Nombres @item.Alumno?.Apellidos</td>
                <td>@item.Materia?.NombreMateria</td>

                <!-- ⭐ NOTA -->
                <td>@item.Nota.ToString("0.00")</td>

                <!-- ⭐ ESTADO -->
                <td>
                    <span class="badge @(item.Nota >= 6 ? "bg-success" : "bg-danger")">
                        @(item.Nota >= 6 ? "Aprobado" : "Reprobado")
                    </span>
                </td>

                <td>@item.Observaciones</td>

                <td>
                    <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                        Editar
                    </a>

                    <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('¿Seguro que deseas eliminar este expediente?')">
                        Eliminar
                    </a>
                </td>
            </tr>
        }

    </tbody>

</table>